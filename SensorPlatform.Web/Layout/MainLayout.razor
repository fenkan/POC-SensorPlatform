@inherits LayoutComponentBase
@inject AuthTokenStore TokenStore
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http

<div class="page theme @ThemeCSSClass">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">

            <!-- CHAT WRAPPER -->
            <div class="chat-wrapper">

                <button class="btn btn-sm btn-outline-primary"
                        @onclick="ToggleChat">
                    🤖
                </button>

                @if (_chatOpen)
                {
                    <div class="chat-panel">

                        <div class="chat-header">
                            🤖 Chat
                            <button class="btn btn-sm btn-close"
                                    @onclick="ToggleChat"></button>
                        </div>

                        <div class="chat-body">
                            @foreach (var msg in _messages)
                            {
                                <div class="msg">@msg</div>
                            }

                            @if (_isLoading)
                            {
                                <div class="msg loading">AI is typing<span class="loading-dots">...</span>
                                </div>
                            }
                        </div>

                        <div class="chat-input">
                            <input class="form-control"
                                   @bind="userInput"
                                   @bind:event="oninput"
                                   @onkeydown="HandleKey"/>

                            <button class="btn btn-primary"
                                    @onclick="Send">
                                Send
                            </button>
                        </div>

                    </div>
                }

            </div>

            <button class="btn btn-outline-secondary btn-sm"
                    @onclick="ToggleTheme">
                Toggle Theme
            </button>

            <button class="btn btn-sm @(IsLoggedIn ? "btn-outline-danger" : "btn-primary")"
                    @onclick="HandleAuth">
                @(IsLoggedIn ? "Logout" : "Login")
            </button>

        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool _darkModeEnabled;
    private bool _isLoading;
    private string _token = string.Empty;
    private bool _chatOpen;

    private List<string> _messages = new();
    private string userInput = string.Empty;

    private bool IsLoggedIn => !string.IsNullOrEmpty(_token);
    private string ThemeCSSClass => _darkModeEnabled ? "dark-theme" : "light-theme";

    protected override async Task OnInitializedAsync()
    {
        _token = await TokenStore.GetTokenAsync() ?? string.Empty;
        var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "darkMode");
        _darkModeEnabled = saved?.ToLower() == "true";
    }

    private void ToggleChat()
    {
        _chatOpen = !_chatOpen;
    }

    // 💬 SEND MESSAGE + BOT RESPONSE
    private async Task Send()
{
    if (string.IsNullOrWhiteSpace(userInput))
        return;

    var message = userInput;

    _messages.Add("You: " + message);

    userInput = string.Empty;
    _isLoading = true;

    await InvokeAsync(StateHasChanged); // UI upp direkt

    var response = await Http.PostAsJsonAsync("api/chat", message);
    var reply = await response.Content.ReadAsStringAsync();

    _isLoading = false;
    _messages.Add("AI: " + reply);
}

    // ⌨️ ENTER SUPPORT
    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Send();
        }
    }

    // 🤖 SIMPLE BOT LOGIC
    private string GetBotReply(string input)
    {
        input = input.ToLower();

        if (input.Contains("hello") || input.Contains("hi"))
            return "Hello 👋 how can I help?";

        if (input.Contains("sensor"))
            return "You can check sensors in the dashboard.";

        if (input.Contains("time"))
            return DateTime.Now.ToString();

        return "I didn't understand that 🤔";
    }

    private async Task ToggleTheme()
    {
        _darkModeEnabled = !_darkModeEnabled;
        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "darkMode",
            _darkModeEnabled.ToString().ToLower()
        );
    }

    private async Task HandleAuth()
    {
        if (IsLoggedIn)
        {
            await TokenStore.ClearTokenAsync();
            _token = string.Empty;
            Nav.NavigateTo("/login");
        }
        else
        {
            Nav.NavigateTo("/login");
        }
    }
}